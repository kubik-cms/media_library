upload = image.object
file_meta = upload.file.metadata
public_url = upload.file_url
filename = file_meta["filename"]
header_partial = helpers.kubik_media_admin_fieldset_header_partial
form_builder = image.form_builder

details_actions = helpers.safe_join([
  helpers.render(
    partial: "admin/kubik_media_uploads/copy_media_link_field",
    locals: { url: upload.public_media_url, variant: :legend }
  ),
  (
    if helpers.lookup_context.exists?("kubik_ai/admin/media_upload_ai_legend_trigger", [], true)
      helpers.render("kubik_ai/admin/media_upload_ai_legend_trigger", upload: upload)
    end
  )
].compact, " ")

div class: "kubik-admin-show-panels kubik-media-upload-pdf-panels" do
  panel "Details", class: "panel__double" do
    div class: "kubik-admin-fieldset kubik-admin-fieldset--form" do
      render partial: header_partial, locals: { title: "Document details", actions: details_actions }
      div class: "kubik-admin-fieldset__body kubik-admin-fieldset__body--inputs" do
        insert_tag ActiveAdmin::Views::SemanticInputsProxy, form_builder, name: "" do
          image.fields_for :additional_info do |f|
            if KubikMediaLibrary.wysiwyg_available?
              text_node f.input :document_title, as: :kubik_wysiwyg, required: false, input_html: { value: upload.additional_info["document_title"] }
            else
              text_node f.input :document_title, label: "Title", required: false, input_html: { value: upload.additional_info["document_title"] }
            end
          end
          image.fields_for :additional_info do |f|
            if KubikMediaLibrary.wysiwyg_available?
              text_node f.input :document_description, as: :kubik_wysiwyg, required: false, input_html: { value: upload.additional_info["document_description"] }
            else
              text_node f.input :document_description, label: "Description", required: false, input_html: { value: upload.additional_info["document_description"] }
            end
          end
          if KubikMediaLibrary.tagging_available?
            tag_options = {
              label: "Tags",
              hint: "Comma-separated labels (e.g. hero, brochure, 2024)",
              min_length: 1,
              required: false
            }
            if helpers.kubik_tags_field_available?
              tag_options[:as] = :"kubik/tags"
              tag_options[:suggestions_url] = lambda {
                tag_suggestions_admin_kubik_media_uploads_path
              }
            end
            text_node form_builder.input :media_tag_list, **tag_options
          end
        end
      end
    end
  end

  panel "Preview", class: "panel__double" do
    div class: "kubik-admin-fieldset kubik-preview-captures-fieldset" do
      div class: "kubik-admin-fieldset__body" do
        render(
          partial: "admin/kubik_media_uploads/pdf_document_preview",
          locals: { upload: upload, public_url: public_url, filename: filename }
        )
      end
    end
  end
end
