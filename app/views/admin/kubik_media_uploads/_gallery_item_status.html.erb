<% upload = local_assigns.fetch(:upload) %>
<div class="kubik-media-gallery--media_item_container--status">
  <%= render Kubik::Media::ProcessingProgressComponent.new(upload: upload) %>
  <div class="kubik-media-gallery--media_item_container--actions">
    <% if defined?(KubikAi) && KubikAi::Media::GalleryIndicator.gallery_attention?(upload) %>
      <%= render "kubik_ai/admin/media_gallery_ai_indicator", upload: upload %>
    <% end %>
    <%= render "copy_media_link_icon", url: upload.public_media_url %>
    <%= link_to("delete",
                admin_kubik_media_upload_path(upload),
                class: "material-symbols-outlined kubik-media-gallery--media_item_container--icon",
                method: :delete,
                data: { confirm: "Are you sure?" }) %>
  </div>
</div>
