attributes_table_for image.object do
  row 'Original' do
    render(
      partial: "admin/kubik_media_uploads/media_version_line",
      locals: { label: "Original", url: image.object.image_url }
    )
  end
  row 'Optimised' do
    render(
      partial: "admin/kubik_media_uploads/media_version_line",
      locals: { label: "Optimised", url: image.object.image_url(:optimised) }
    )
  end
  Kubik::MediaUpload.available_derivatives.each do |group, crops|
    row group.to_s.humanize do
      render(
        partial: "admin/kubik_media_uploads/media_version_lines_group",
        locals: { crops: crops, upload: image.object }
      )
    end
  end
end
