attributes_table_for image.object do
  row 'Original' do
    [link_to('Original ', image.object.image_url), "- #{image.object.image_url}" ].join(' ').html_safe
  end
  row 'Optimised' do
    [link_to("Optimised", image.object.image_url(:optimised)), "- #{image.object.image_url(:optimised)}"].join(' ').html_safe
  end
  Kubik::MediaUpload.available_derivatives.each do |group, crops|
    row group.to_s.humanize do
      crops.map do |crop|
        derivative_rows = [[crop[0], crop[0].to_s.humanize]]
        KubikMediaLibrary.processor.available_modern_formats.each do |format|
          derivative_rows << [:"#{crop[0]}_#{format}", "#{crop[0].to_s.humanize} (#{format.upcase})"]
        end

        derivative_rows.map do |derivative, label|
          div [
            link_to(label, image.object.image_url(derivative)),
            "- #{image.object.image_url(derivative)}"
          ]
        end
      end.join(' ').html_safe
    end
  end
end
