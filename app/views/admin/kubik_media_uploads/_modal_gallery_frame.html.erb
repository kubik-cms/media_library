<%# Turbo frame root for the media picker modal (must match kubik-modal frame id). %>
<%= turbo_frame_tag(
      request.headers["Turbo-Frame"].presence || KubikMediaLibrary::MODAL_GALLERY_TURBO_FRAME
    ) do %>
  <%= render "media_library_listing",
             modal: modal,
             turbo_action: turbo_action,
             gallery_filter_params: gallery_filter_params,
             collection: collection %>
<% end %>
