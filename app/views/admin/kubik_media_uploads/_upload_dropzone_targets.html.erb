<div class="kubik-media-gallery--upload-errors"
     data-image_dropzone-target="errors"
     hidden
     aria-live="polite">
  <div class="kubik-media-gallery--upload-errors__header">
    <span class="kubik-media-gallery--upload-errors__title">Upload issues</span>
    <button type="button"
            class="kubik-media-gallery--upload-errors__dismiss-all"
            data-action="click->image_dropzone#dismissAllErrors">
      Dismiss all
    </button>
  </div>
  <ul class="kubik-media-gallery--upload-errors__list"
      data-image_dropzone-target="errorList"></ul>
</div>
<div class="kubik-media-gallery--upload-previews"
     data-image_dropzone-target="previews"></div>
