<% turbo_action = local_assigns.fetch(:turbo_action) { false } %>
<% turbo_action = turbo_action.present? ? turbo_action : false %>
<% modal = local_assigns.fetch(:modal) { false } %>
<% gallery_filter_params = local_assigns.fetch(:gallery_filter_params) { @gallery_filter_params || {} } %>
<% collection = local_assigns.fetch(:collection) { @collection } %>
<%= render "media_library_listing",
           modal: modal,
           turbo_action: turbo_action,
           gallery_filter_params: gallery_filter_params,
           collection: collection %>
